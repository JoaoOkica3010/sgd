# ------------------------------------------------------------------
# Variante para desenvolvimento local com XAMPP (Apache + PHP + MySQL),
# sem Docker, sem PostgreSQL, sem Redis, sem MinIO.
#
# Como usar:
#   copy backend\.env.xampp.example backend\.env
#
# Depois:
#   1. Abra o phpMyAdmin do XAMPP (http://localhost/phpmyadmin) e crie
#      uma base de dados chamada "sgd" (Encoding: utf8mb4_unicode_ci).
#   2. No terminal, dentro da pasta backend:
#        composer install
#        php artisan key:generate
#        php artisan migrate
#        php artisan db:seed --class=PerfilSeeder
#        php artisan serve
# ------------------------------------------------------------------

APP_NAME="SGD - MTTECD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=pt_PT

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DOMAIN=localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL/MariaDB do XAMPP — porta e utilizador predefinidos do XAMPP
# (utilizador "root" sem palavra-passe, tipico em instalacoes locais).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sgd
DB_USERNAME=root
DB_PASSWORD=

# Sem Redis instalado: usar drivers baseados em ficheiro/base de dados.
# Suficiente para desenvolvimento local; a producao continua a usar Redis
# (ver Documento de Arquitetura Tecnica, seccao 3.6).
SESSION_DRIVER=file
SESSION_LIFETIME=15
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Sem MinIO instalado: anexos gravados localmente em storage/app/private.
FILESYSTEM_DISK=local
SGD_DISCO_ANEXOS=local

MAIL_MAILER=log

SGD_ANEXO_TAMANHO_MAXIMO_MB=20
SGD_2FA_PERFIS_OBRIGATORIOS=MIN,SG,CG
